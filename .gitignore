# Lista blanca: solo archivos de código fuente y assets necesarios
/*
!.gitignore
!app.py
!chat_clips.py
!chat_overlay.py
!montar.py
!miniatura.py
!mcp_server.py
!youtube.py
!tiktok.py
!ui.html
!dropia.ico
!instalar.bat
!instalar.py
!empaquetar.py
!requirements.txt
!README.md
!LICENSE
!SKILL.md
!.claude/
!fuentes/
!bin/
!guia/
!web/
!trabajo/.gitkeep

# Exclusiones de archivos multimedia pesados y temporales
*.pdb
*.part
*.mp4
*.mkv
*.webm
*.avi
*.jpg
*.jpeg
*.png
*.ass
*.captions.json
trabajo/*
!trabajo/.gitkeep
canales.json
tokens/
secrets/
cookies.txt
__pycache__/
.pytest_cache/
.venv/
env/
